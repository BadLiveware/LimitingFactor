<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LimitingFactor.LowLevel</AssemblyName>
    <RootNamespace>LimitingFactor.LowLevel</RootNamespace>
    <Description>Resource-safe Linux namespace, FUSE approval, and OverlayFS process-sandbox mechanisms.</Description>
    <Version>0.1.0</Version>
    <Authors>Limiting Factor contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LimitingFactor.Native/LimitingFactor.Native.csproj" />
    <PackageReference Include="LTRData.FuseDotNet" Version="1.0.0.14" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
